<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lingkaran Efek Glow</title>

<style>
body {
    margin: 0;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #0f172a;
}

.lingkaran {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: linear-gradient(45deg, #00d4ff, #0066ff);
    box-shadow:
        0 0 20px #00d4ff,
        0 0 40px #00d4ff,
        0 0 60px #0066ff;
    animation: pulse 2s infinite ease-in-out;
}

@keyframes pulse {
    0% {
        transform: scale(1);
        box-shadow:
            0 0 20px #00d4ff,
            0 0 40px #00d4ff,
            0 0 60px #0066ff;
    }

    50% {
        transform: scale(1.15);
        box-shadow:
            0 0 40px #00d4ff,
            0 0 80px #00d4ff,
            0 0 120px #0066ff;
    }

    100% {
        transform: scale(1);
        box-shadow:
            0 0 20px #00d4ff,
            0 0 40px #00d4ff,
            0 0 60px #0066ff;
    }
}
</style>
</head>
<body>

<div class="lingkaran"></div>

</body>
</html>